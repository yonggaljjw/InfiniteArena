# 역할: 최초 실행 설정 예시. MYSQL_*는 DB 초기 생성과 서버 접속에 함께 쓰고 ALLOWED_ORIGINS는 WS 브라우저 출처를 제한합니다.
# 개발 전용 예시 비밀번호입니다. 외부 공개 전에 변경하세요.
MYSQL_DATABASE=arena
MYSQL_USER=arena
MYSQL_PASSWORD=arena_dev_password
MYSQL_ROOT_PASSWORD=arena_dev_root_password
HTTP_PORT=8080
ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
# HTTPS로 운영할 때는 true로 변경
COOKIE_SECURE=true


